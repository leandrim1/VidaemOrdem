# Variáveis públicas do frontend (prefixo VITE_). Nunca coloque secrets aqui:
# tudo com VITE_ é embutido no bundle e fica visível no navegador.

# Futuro: integração com Supabase (a chave "anon" é pública por design; a segurança vem do RLS)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Futuro: chave publicável do Stripe (pk_...). A secret key fica apenas no backend.
# VITE_STRIPE_PUBLISHABLE_KEY=
